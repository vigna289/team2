<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV009 — Materialized view: mv_daily_recon_summary
 WHAT:    Daily aggregate of matched/break counts + total notional,
          used by dashboard's "today at a glance" cards.
 HOW:     REFRESH MATERIALIZED VIEW CONCURRENTLY (requires unique index).
          Postgres-only. Refresh is a separate cron job (Day 6 task).
 WHY:     Computing daily stats over a partitioned 50M-row table on every
          dashboard load = 600ms+. Matview read = ~5ms.
 OBSERVE: SELECT * FROM mv_daily_recon_summary returns one row per day.
          REFRESH MATERIALIZED VIEW CONCURRENTLY mv_daily_recon_summary
          succeeds without error.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="005-mv-daily-recon-summary" author="trainer" labels="postgres-only,analytics">
        <description>Create materialized view for daily recon summary aggregates</description>
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sql splitStatements="false"><![CDATA[
            CREATE MATERIALIZED VIEW mv_daily_recon_summary AS
            SELECT
                trade_date,
                COUNT(*)                                                   AS total_trades,
                COUNT(*) FILTER (WHERE status = 'MATCHED')                 AS matched_trades,
                COUNT(*) FILTER (WHERE status IN ('UNMATCHED','DISPUTED')) AS break_trades,
                COALESCE(SUM(quantity * price), 0)                         AS total_notional
            FROM trades
            WHERE deleted_at IS NULL
            GROUP BY trade_date
            WITH NO DATA;

            CREATE UNIQUE INDEX uq_mv_daily_recon_summary_trade_date
                ON mv_daily_recon_summary (trade_date);

            REFRESH MATERIALIZED VIEW mv_daily_recon_summary;
        ]]></sql>
        <rollback>
            <sql>DROP MATERIALIZED VIEW IF EXISTS mv_daily_recon_summary;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>